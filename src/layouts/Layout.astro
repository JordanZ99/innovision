---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'INNOVISION — Casa Productora Cinematográfica' } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Innovision — Casa productora y gestora de imagen cinematográfica en Quintana Roo. Video musical urbano, producciones comerciales y videoclips de alto impacto." />
  <title>{title}</title>
  <link rel="icon" type="image/png" href="/logo.png" />

  <!-- Google Fonts preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- GSAP CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
</head>
<body>
  <div class="scanlines" aria-hidden="true"></div>
  <div class="scan-sweep" aria-hidden="true"></div>
  <slot />
</body>
</html>



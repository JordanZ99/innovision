---
// Manifesto — Digital Sovereignty terminal
---

<section class="manifesto section-pad" id="manifesto">
  <div class="manifesto__terminal reveal">
    <!-- Terminal bar -->
    <div class="manifesto__bar">
      <span class="manifesto__dot manifesto__dot--red"></span>
      <span class="manifesto__dot manifesto__dot--yellow"></span>
      <span class="manifesto__dot manifesto__dot--green"></span>
      <span class="manifesto__bar-title">DIAGNOSTIC.EXE</span>
    </div>

    <!-- Terminal body -->
    <div class="manifesto__body">
      <div class="manifesto__header">
        <span class="manifesto__prompt" data-i18n="manifesto.header">&gt; RUNNING FULL SYSTEM SCAN...</span>
        <span class="manifesto__cursor">_</span>
      </div>

      <div class="manifesto__text">
        <h2 class="manifesto__title" data-reveal data-i18n="manifesto.title">INNOVISION</h2>
        <p class="manifesto__subtitle" data-reveal data-i18n="manifesto.subtitle">Manifiesto: Soberanía Digital 2026 - 2030</p>
        <p class="manifesto__paragraph" data-reveal data-i18n-html="manifesto.p1">
          La división de Inteligencia diseña la estrategia; InnoVision ejecuta la operatividad. Juntos, estamos comprometidos con la creación de un ecosistema completo y autosustentable, donde los datos, la audiencia y el dinero se quedan contigo.
        </p>
        <p class="manifesto__paragraph" data-reveal data-i18n-html="manifesto.p2">
          Las plataformas tradicionales de streaming de video y música han convertido al creador en un inquilino. Se quedan con los mayores porcentajes de ganancia y dictan las reglas del juego, cobrando un "impuesto" altísimo simplemente por prestarte un ecosistema de distribución que tú mismo alimentas con tu talento.
        </p>
        <p class="manifesto__paragraph" data-reveal data-i18n-html="manifesto.p3">
          Por eso, activamos el <em>Plan de Soberanía Digital 2026 - 2030</em>.
        </p>
        <p class="manifesto__paragraph" data-reveal data-i18n-html="manifesto.p4">
          Nuestro compromiso es guiar a quienes estén listos para dejar de depender de terceros. Construiremos juntos nuevos sistemas, infraestructuras cerradas y flujos económicos que te permitan lograr una distribución propia, blindar tu percepción pública y tener control absoluto y total de tu dinero y tus datos.
        </p>
      </div>

      <div class="manifesto__footer-text">
        <span class="manifesto__prompt manifesto__prompt--green" data-i18n="manifesto.footer">&gt; SCAN COMPLETE. INTEGRITY: 100%</span>
      </div>
    </div>
  </div>
</section>

<style>
  .manifesto {
    background: var(--color-concrete);
    position: relative;
  }

  .manifesto::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.04) 2px,
      rgba(0, 0, 0, 0.04) 4px
    );
    pointer-events: none;
  }

  .manifesto__terminal {
    max-width: 800px;
    margin: 0 auto;
    border: 1px solid var(--color-steel);
    background: var(--color-void);
    position: relative;
    z-index: 1;
  }

  /* ── Terminal bar ── */
  .manifesto__bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-steel);
    background: var(--color-concrete);
  }

  .manifesto__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .manifesto__dot--red { background: var(--color-red-neon); }
  .manifesto__dot--yellow { background: var(--color-amber); }
  .manifesto__dot--green { background: var(--color-green-neon); }

  .manifesto__bar-title {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--color-steel);
    margin-left: 12px;
    text-transform: uppercase;
  }

  /* ── Terminal body ── */
  .manifesto__body {
    padding: 40px;
  }

  .manifesto__header {
    margin-bottom: 40px;
  }

  .manifesto__prompt {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-green-neon);
    letter-spacing: 0.05em;
  }

  .manifesto__prompt--green {
    color: var(--color-green-neon);
  }

  .manifesto__cursor {
    display: inline-block;
    color: var(--color-green-neon);
    animation: cursorBlink 0.7s step-end infinite;
    margin-left: 2px;
  }

  /* ── Manifesto text ── */
  .manifesto__paragraph {
    font-family: var(--font-mono);
    font-size: clamp(14px, 1.6vw, 17px);
    line-height: 1.8;
    color: var(--color-white-static);
    margin-bottom: 32px;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s var(--ease-out-expo), transform 0.8s var(--ease-out-expo);
  }

  .manifesto__paragraph.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  .manifesto__title {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 400;
    color: var(--color-white-static);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 8px;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s var(--ease-out-expo), transform 0.8s var(--ease-out-expo);
  }

  .manifesto__title.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  .manifesto__subtitle {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-orange);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 36px;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s var(--ease-out-expo) 0.1s, transform 0.8s var(--ease-out-expo) 0.1s;
  }

  .manifesto__subtitle.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  .manifesto__paragraph em {
    color: var(--color-orange);
    font-style: italic;
  }

  /* ── Footer text ── */
  .manifesto__footer-text {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--color-steel);
  }

  @media (max-width: 768px) {
    .manifesto__body {
      padding: 24px;
    }
  }
</style>

<script>
  function initManifesto() {
    // All revealable elements: title, subtitle, then paragraphs
    const revealables = document.querySelectorAll('.manifesto__title, .manifesto__subtitle, .manifesto__paragraph');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            // Stagger the reveal by position in sequence
            const delay = Array.from(revealables).indexOf(entry.target) * 200;
            setTimeout(() => {
              entry.target.classList.add('revealed');
            }, delay);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 }
    );

    revealables.forEach((el) => observer.observe(el));

    // Reveal terminal wrapper
    const terminal = document.querySelector('.manifesto__terminal');
    if (terminal) {
      const termObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              termObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1 }
      );
      termObserver.observe(terminal);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initManifesto);
  } else {
    initManifesto();
  }
</script>
